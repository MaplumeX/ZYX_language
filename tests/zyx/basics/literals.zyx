# 各类字面量与打印格式
print(42)                 # expect: 42
print(-7)                 # expect: -7
print(1_000_000)          # expect: 1000000
print(0xff)               # expect: 255
print(3.14)               # expect: 3.14
print(2.0)                # expect: 2.0
print(1.5e3)              # expect: 1500.0
print(true, false, nil)   # expect: true false nil
print("hello")            # expect: hello
print([1, "a", nil, 2.5]) # expect: [1, "a", nil, 2.5]
print([])                 # expect: []
print([[1, 2], [3]])      # expect: [[1, 2], [3]]
print(0..5)               # expect: 0..5
print(1..=3)              # expect: 1..4
print()                   # expect:
print(1, "two", 3.0)      # expect: 1 two 3.0
