let a = [10, 20, 30]
print(a[0], a[2], a[-1])         # expect: 10 30 30
a[1] = 99
print(a)                         # expect: [10, 99, 30]
a[-1] += 1
print(a)                         # expect: [10, 99, 31]
print(len(a))                    # expect: 3
print(a[0..2])                   # expect: [10, 99]
print(a[1..len(a)])              # expect: [99, 31]
print(a[0..=0])                  # expect: [10]
print(a[5..9])                   # expect: []

# 二维数组
let grid = array(3, array(3, 0))
grid[1][2] = 5
print(grid)                      # expect: [[0, 0, 0], [0, 0, 5], [0, 0, 0]]
