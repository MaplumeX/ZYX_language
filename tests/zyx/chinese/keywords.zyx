结构 学生 { 姓名, 分数 }

实现 学生 {
    函数 及格(自己) { 自己.分数 >= 60 }
}

函数 等级(分) {
    匹配 分 {
        90..=100 => "优",
        60..90 => "良",
        _ => "差",
    }
}

令 名单 = [学生("小明", 95), 学生("小红", 72), 学生("小刚", 40)]
对于 序号, 人 在 名单 {
    print("{序号 + 1}. {人.姓名}：{等级(人.分数)}")
}
# expect: 1. 小明：优
# expect: 2. 小红：良
# expect: 3. 小刚：差

令 计数 = 0
当 真 {
    计数 += 1
    如果 计数 < 3 { 继续 }
    跳出
}
print(计数)                      # expect: 3

函数 判断(x) {
    如果 x 且 非 假 { 返回 "真的" } 否则 { 返回 "假的" }
}
print(判断(真), 判断(假))         # expect: 真的 假的
print(空 == nil, 真 或 假)        # expect: true true
print(名单[2].及格())             # expect: false
