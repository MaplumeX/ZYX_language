for i in 0..3 { write(i, "") }
print()                              # expect: 0 1 2 
for i in 1..=3 { write(i, "") }
print()                              # expect: 1 2 3 
for x in ["a", "b"] { write(x, "") }
print()                              # expect: a b 
for i, x in ["a", "b", "c"] { write("{i}={x}", "") }
print()                              # expect: 0=a 1=b 2=c 
for i, n in 10..13 { write("{i}:{n}", "") }
print()                              # expect: 0:10 1:11 2:12 
for i in 5..2 { print("never") }

# 嵌套循环中的 break 只跳出最内层
for i in 0..3 {
    for j in 0..3 {
        if j == 1 { break }
        write("{i}{j}", "")
    }
}
print()                              # expect: 00 10 20 
for i in 0..6 {
    if i % 2 == 0 { continue }
    write(i, "")
}
print()                              # expect: 1 3 5 

# 遍历时追加元素：按当前长度继续遍历
let xs = [1, 2]
for x in xs {
    if x < 4 { xs.push(x + 2) }
}
print(xs)                            # expect: [1, 2, 3, 4, 5]
