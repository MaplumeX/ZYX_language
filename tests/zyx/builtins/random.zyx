# 同一种子产生相同序列
seed(123)
let a = [random(1, 100), random(1, 100), random(1, 100)]
seed(123)
let b = [random(1, 100), random(1, 100), random(1, 100)]
print(a == b)                    # expect: true

# 结果落在闭区间内，且两端都能取到
let seen_lo = false
let seen_hi = false
for i in 0..2000 {
    let r = random(1, 3)
    assert(r >= 1 and r <= 3, "out of range: {r}")
    if r == 1 { seen_lo = true }
    if r == 3 { seen_hi = true }
}
print(seen_lo, seen_hi)          # expect: true true
print(random(5, 5))              # expect: 5
let t = time()
print(type(t), t > 0)            # expect: float true
