print(int("42"), int(" -7 "), int(3.9), int(-3.9), int(true))   # expect: 42 -7 3 -3 1
print(float(2), float("2.5"), float(false))                     # expect: 2.0 2.5 0.0
print(str(12) + str(3.0) + str(nil) + str([1]))                 # expect: 123.0nil[1]
print(parse_int("15"), parse_int("abc"), parse_int(""))         # expect: 15 nil nil
print(type(1), type(1.0), type("s"), type(true), type(nil), type([]))   # expect: int float str bool nil array

# 固定小数位格式化：按精确二进制值舍入，与 Python 的 f"{x:.2f}" 一致
print(fixed(3.14159, 2), fixed(2.675, 2), fixed(-1.5, 2), fixed(0.1 + 0.2, 3))   # expect: 3.14 2.67 -1.50 0.300
print(fixed(5, 2), fixed(2.5, 0), fixed(-3, 0), type(fixed(1, 1)))              # expect: 5.00 2 -3 str
print(fixed(9223372036854775807, 1))                                             # expect: 9223372036854775807.0
print(parse_float("2.5"), parse_float(" -1e3 "), parse_float("7"))               # expect: 2.5 -1000.0 7.0
print(parse_float("abc"), parse_float(""), parse_float("1.2.3"))                 # expect: nil nil nil
