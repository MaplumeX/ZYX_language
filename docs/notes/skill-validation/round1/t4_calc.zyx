# 交互式计算器：逐行读取 "a op b"
let count = 0

while true {
    let line = input()
    if line == nil { break }
    let parts = line.trim().split(" ") |> filter(fn(p) => len(p) > 0)
    if len(parts) != 3 {
        print("错误：无法解析")
        continue
    }
    let a = parse_int(parts[0])
    let op = parts[1]
    let b = parse_int(parts[2])
    if a == nil or b == nil {
        print("错误：无法解析")
        continue
    }
    if op == "/" and b == 0 {
        print("错误：除数不能为 0")
        continue
    }
    let result = match op {
        "+" => a + b,
        "-" => a - b,
        "*" => a * b,
        "/" => float(a) / b,
        _ => nil,
    }
    if result == nil {
        print("错误：无法解析")
        continue
    }
    print("= {result}")
    count += 1
}

print("共计算 {count} 条")
