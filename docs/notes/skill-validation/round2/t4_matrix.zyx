# 矩阵运算

fn matmul(a, b) {
    let n = len(a)
    let m = len(b[0])
    let k = len(b)
    let c = array(n, array(m, 0))
    for i in 0..n {
        for j in 0..m {
            let s = 0
            for t in 0..k {
                s += a[i][t] * b[t][j]
            }
            c[i][j] = s
        }
    }
    c
}

fn transpose(a) {
    let rows = len(a)
    let cols = len(a[0])
    let t = array(cols, array(rows, 0))
    for i in 0..rows {
        for j in 0..cols {
            t[j][i] = a[i][j]
        }
    }
    t
}

fn show(m) {
    for row in m {
        let cells = row |> map(fn(x) => pad_left(x, 5))
        print(join(cells, ""))
    }
}

fn spiral(m) {
    let out = []
    let top = 0
    let bottom = len(m) - 1
    let left = 0
    let right = len(m[0]) - 1
    while top <= bottom and left <= right {
        for j in left..=right { out.push(m[top][j]) }
        top += 1
        for i in top..=bottom { out.push(m[i][right]) }
        right -= 1
        if top <= bottom {
            let j = right
            while j >= left {
                out.push(m[bottom][j])
                j -= 1
            }
            bottom -= 1
        }
        if left <= right {
            let i = bottom
            while i >= top {
                out.push(m[i][left])
                i -= 1
            }
            left += 1
        }
    }
    out
}

let a = [[1, 2, 3], [4, 5, 6]]
let b = [[7, 8], [9, 10], [11, 12]]

print("(a) A × B：")
show(matmul(a, b))

print("(b) A 的转置：")
show(transpose(a))

let m = array(4, array(4, 0))
for i in 0..4 {
    for j in 0..4 {
        m[i][j] = i * 4 + j + 1
    }
}
print("(c) 螺旋顺序：")
print(join(spiral(m), " "))
