# 中文文本处理：静夜思
结构 计数 { 字, 次数 = 0 }

令 诗 = ["床前明月光", "疑是地上霜", "举头望明月", "低头思故乡"]

函数 查找(表, 字) {
    对于 i, 项 在 表 {
        如果 项.字 == 字 { 返回 i }
    }
    -1
}

# 1. 每一行的倒序
print("每行倒序：")
对于 行 在 诗 {
    令 倒 = reverse(行)
    print(倒)
}

# 2. 出现次数最多的汉字（并列时取最先出现的）
令 表 = []
对于 行 在 诗 {
    对于 c 在 行 {
        令 i = 查找(表, c)
        如果 i == -1 {
            表.push(计数(c, 1))
        } 否则 {
            表[i].次数 += 1
        }
    }
}
令 最多 = 表[0]
对于 项 在 表 {
    如果 项.次数 > 最多.次数 { 最多 = 项 }
}
print("出现最多的字：{最多.字}，共 {最多.次数} 次")

# 3. 包含"月"字的行号
令 行号 = []
对于 i, 行 在 诗 {
    如果 contains(行, "月") { 行号.push(i + 1) }
}
令 行号串 = join(行号, ", ")
print("包含“月”的行：{行号串}")
